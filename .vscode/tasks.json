{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "clang++: build current file",
            "type": "shell",
            "command": "C:\\msys64\\clangarm64\\bin\\clang++.exe",
            "args": [
                "-std=c++17",
                "-g",
                "-O0",
                "-Wall",
                "-Wextra",
                "-B",
                "C:\\msys64\\clangarm64\\bin",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}