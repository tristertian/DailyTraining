{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile Active File (clang++)",
            "type": "process",
            "command": "C:/msys64/clangarm64/bin/clang++.exe",
            "args": [
                "-g",
                "-O0",
                "-std=c++17",
                "-Wall",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "silent",
                "panel": "shared",
                "close": true
            },
            "detail": "Compile the currently active .cpp file into a matching .exe for LLDB debugging."
        },
        {
            "label": "Clean Active File Artifacts",
            "type": "process",
            "command": "C:/msys64/usr/bin/rm.exe",
            "args": [
                "-f",
                "${fileDirname}/${fileBasenameNoExtension}.exe",
                "${fileDirname}/out.txt"
            ],
            "problemMatcher": [],
            "detail": "Remove the compiled .exe and out.txt for the active file."
        }
    ]
}
